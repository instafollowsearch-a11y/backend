# Copy to .env and fill in values

PORT=5001
DATABASE_URL=postgres://user:password@localhost:5432/recentfollow
JWT_SECRET=change-me
JWT_EXPIRE=24h
FRONTEND_URL=http://localhost:3000

# Hiker (user info, stories, posts, likers, comments)
HIKER_API_KEY=

# Apify thenetaji/instagram-followers-followings-scraper — followers/following lists only
APIFY_TOKEN=
# Rollback: set to "hiker" to use Hiker for followers/following without redeploying frontend
FOLLOWERS_FOLLOWING_PROVIDER=apify
# Full profile per row (slower/costlier); default false
# APIFY_PROFILE_ENRICHED=false
# Public search maxItem per run (min 1)
APIFY_PUBLIC_MAX_COUNT=10
APIFY_MAX_COUNT=500
# Reuse cached follow lists without re-running Apify (minutes)
FOLLOW_CACHE_TTL_MINUTES=30
# Red-flag liker scans (runs in parallel with Apify): 0 = skip on public (fastest)
PUBLIC_RED_FLAG_POSTS=0
ADVANCED_RED_FLAG_POSTS=6

# Standalone story viewer site (freeinstagramstoryviewer.com)
STORY_VIEWER_ENABLED=true
STORY_VIEWER_RATE_LIMIT_WINDOW_MS=900000
STORY_VIEWER_RATE_LIMIT_MAX=30
STORY_VIEWER_CACHE_TTL_MINUTES=8

STRIPE_SECRET_KEY=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
BCRYPT_ROUNDS=12
