# Copy to .env and fill in values

PORT=5001
DATABASE_URL=postgres://user:password@localhost:5432/recentfollow
JWT_SECRET=change-me
JWT_EXPIRE=24h
FRONTEND_URL=http://localhost:3000

# Hiker (user info, stories, posts, likers, comments)
HIKER_API_KEY=

# Apify DataDoping — followers/following lists only (max_count capped at 500)
APIFY_TOKEN=
# Rollback: set to "hiker" to use Hiker for followers/following without redeploying frontend
FOLLOWERS_FOLLOWING_PROVIDER=apify

STRIPE_SECRET_KEY=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
BCRYPT_ROUNDS=12
