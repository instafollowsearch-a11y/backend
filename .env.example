# Copy to .env and fill in values

PORT=5055
DATABASE_URL=postgres://user:password@localhost:5432/recentfollow
JWT_SECRET=change-me
JWT_EXPIRE=24h
FRONTEND_URL=http://localhost:3000

# Hiker (user info, stories, posts, likers, comments)
HIKER_API_KEY=

# Apify thenetaji/instagram-followers-followings-scraper — followers/following lists only
APIFY_TOKEN=
# Follower/following lists: apify (default, requires APIFY_TOKEN). Set "hiker" only for emergency rollback.
FOLLOWERS_FOLLOWING_PROVIDER=apify
# Apify empty-list retries (default 2 attempts)
# APIFY_LIST_RETRY_ATTEMPTS=2
# Full profile per row (slower/costlier); default false
# APIFY_PROFILE_ENRICHED=false
# Items per "Load more" click (premium followers/following UI)
FOLLOW_LIST_PAGE_SIZE=10
# Public search: max followers/following fetched per run (min 1)
APIFY_PUBLIC_MAX_COUNT=2
# Premium: max items cached per list (load more in pages of FOLLOW_LIST_PAGE_SIZE, up to this cap)
APIFY_MAX_COUNT=50
# Reuse cached follow lists without re-running Apify (minutes)
FOLLOW_CACHE_TTL_MINUTES=30
# Red-flag liker scans (runs in parallel with Apify): 0 = skip on public (fastest)
PUBLIC_RED_FLAG_POSTS=0
ADVANCED_RED_FLAG_POSTS=6
# Shared Activity (premium): posts per user + comment scan budget
SHARED_ACTIVITY_POST_LIMIT=10
SHARED_ACTIVITY_COMMENT_CAP=40
SHARED_ACTIVITY_CONCURRENCY=5

# Standalone story viewer site (freeinstagramstoryviewer.com)
STORY_VIEWER_ENABLED=true
STORY_VIEWER_RATE_LIMIT_WINDOW_MS=900000
STORY_VIEWER_RATE_LIMIT_MAX=30
STORY_VIEWER_CACHE_TTL_MINUTES=8
# Max posts fetched for story viewer (UI may show fewer with blur)
STORY_VIEWER_POST_LIMIT=9

STRIPE_SECRET_KEY=
# Must match STRIPE_SECRET_KEY mode (sk_test → test price IDs, sk_live → live price IDs)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
# Optional; defaults to DD3Mdjdl if unset
STRIPE_COUPON_ID=
# Stripe Dashboard → Developers → Webhooks → endpoint /api/payment/webhook
STRIPE_WEBHOOK_SECRET=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
BCRYPT_ROUNDS=12
